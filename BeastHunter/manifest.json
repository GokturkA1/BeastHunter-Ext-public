{
  "manifest_version": 3,
  "name": "Wolvesville Room Bot",
  "description": "Bu uzantı Wolvesville içinde otomasyonlu bir oda açılmasını sağlar. cr: GokturkA",
  "version": "1.0.0",
  "permissions": ["storage", "unlimitedStorage", "cookies"],
  "host_permissions": ["*://*.wolvesville.com/*"],
  "action": {
    "default_popup": "index.html"
  },
  "background": {
    "service_worker": "background.js"
  },
  "content_scripts": [
    {
      "matches": ["https://*.wolvesville.com/*"],
      "js": ["contentScript.js"]
    }
  ],
  "content_security_policy": {
    "extension_pages": "default-src 'self' 'unsafe-eval'; style-src 'self' 'unsafe-inline'; script-src 'self'; connect-src *;",
    "worker_src": "script-src 'self' 'unsafe-eval'; object-src 'self'"
  }
}